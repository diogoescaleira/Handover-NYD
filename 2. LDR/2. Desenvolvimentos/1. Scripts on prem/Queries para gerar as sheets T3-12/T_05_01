drop table bu_captools_work.T_05_01;
select * From bu_captools_work.T_05_01;

CREATE TABLE bu_captools_work.T_05_01 AS
SELECT

cast(row_number() over (order by zx.tayd91c0_gelem30) as string) as Number,

CASE
  WHEN zx.contraparte_i_desc="particulares" THEN "r0310 - Deposits, not covered but preferential (BRRD art. 108)"
  WHEN zx.contraparte_i_desc="outras empresas nao financeiras" AND zx.flag_pme="1" THEN "r0310 - Deposits, not covered but preferential (BRRD art. 108)"
  ELSE "r0320 - Deposits, not covered and not preferential"
END AS Line,

CASE
    WHEN zx.csector_inst="S128" OR zx.contraparte_i_desc="outras instituicoes financeiras" THEN "c006x   - Insurance firms & pension funds"
    WHEN zx.contraparte_i_desc="particulares" THEN "c001x   - Households"
    WHEN zx.contraparte_i_desc="outras empresas nao financeiras" AND zx.flag_pme="1" THEN "c002x   - Micro & SME"
    WHEN zx.contraparte_i_desc="outras empresas nao financeiras" AND (zx.flag_pme IN("0", "") OR zx.flag_pme IS NULL) THEN "c003x   - Corporates"
    WHEN zx.contraparte_i_desc="instituicoes de credito" THEN "c004x   - Institutions"
    WHEN zx.contraparte_i_desc="outras instituicoes financeiras" THEN "c005x   - Other financial corporations"
    WHEN zx.contraparte_i_desc="setor publico" THEN "c008x   - Government, central banks & supranationals"
    ELSE ""
END as Coluna,

IF(zx.contraparte_i_desc="outras empresas nao financeiras" AND zx.flag_pme="1", "Rank 13 - Ranking in insolvency (master scale)", "Rank 12 - Ranking in insolvency (master scale)") AS Insolvency_ranking,


CONCAT("PTXSTJOM", lpad(cast(row_number() over (order by zx.tayd91c0_gelem30) as string), 4, "0")) AS Contract_identifier,


CONCAT("M", lpad(cast(row_number() over (order by zx.tayd91c0_gelem30) as string), 4, "0")) AS Counterparty_identifier,


"Type of identifier, other than LEI or MFI code" AS Type_of_identifier,


"Portugal" AS Governing_law,


zx.tayd91c0_gelem30 as Currency,

nvl(zx.SUM_of_msaldo_final,0) + nvl(zx.SUM_of_msaldo_final_s128,0) - nvl(zx.SUM_of_mcoberto_eu,0) - nvl(zx.SUM_of_mcoberto_me,0) - nvl(zx.SUM_of_mcoberto_eur_s128,0) - nvl(zx.SUM_of_mcoberto_me_s128,0) AS Outstanding_principal_amount,


IF(zx.SUM_of_SUM_of_msaldo_final1="" OR zx.SUM_of_SUM_of_msaldo_final1 IS NULL, zx.SUM_of_SUM_of_msaldo_final, zx.SUM_of_SUM_of_msaldo_final1 + zx.SUM_of_SUM_of_msaldo_final) AS Accured_interest, ---- perguntar miguel


AVG_of_tx_contrato_pas_juros AS Current_interest_rate,


"Unsecured" AS Secured_unsecured,


"0" AS Amount_pledge_lien_collateral,


"" AS Amount_meeting,


zx.ref_date AS Issuance_date,


IF(from_unixtime(unix_timestamp(zx.ref_date ,'yyyy-MM-dd'),'u')=5, date_add(zx.ref_date,3), IF(from_unixtime(unix_timestamp(zx.ref_date,'yyyy-MM-dd'),'u')=6, date_add(zx.ref_date,2), date_add(zx.ref_date,1))) AS Earliest_redemption_date,


"0" AS Funding_amount


FROM bu_captools_work.QUERY_FOR_FILTER_FOR_QUERY__0026 as zx;
